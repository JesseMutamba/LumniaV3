# Existing deployment authentication and persistent database settings remain required.
# Set secrets in the hosting environment, never commit real values.
LUMNIA_ADMIN_TOKEN=
LUMNIA_SESSION_SECRET=
# Base64 encoding of 32 random bytes; preserve across restarts/releases.
LUMNIA_CREDENTIAL_KEY=
# Optional server-wide provider. Organization keys can instead be saved in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LUMNIA_OPENAI_MODEL=gpt-5-mini
LUMNIA_ANTHROPIC_MODEL=claude-sonnet-4-5
