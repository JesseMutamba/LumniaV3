# Required to publish. Generate with: make token
LUMNIA_ADMIN_TOKEN=

# Origins allowed to call the API
LUMNIA_ORIGINS=http://localhost:5173

# SQLite location. Point at a mounted volume in production.
# LUMNIA_DB=/data/lumnia.db

# Optional: create clients on first boot
# LUMNIA_BOOTSTRAP_ORGS=pvak:PVAK:Mwebe & Kwenge, RDC
